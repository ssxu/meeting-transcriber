# ===== Qwen3-ASR（OpenAI 兼容）=====
# ASR 服务地址（Qwen3-ASR Server）
ASR_BASE_URL=http://192.168.100.51:7034
ASR_MODEL=qwen3-asr
ASR_TIMEOUT=600
# X-NLS-Token 安全访问令牌（可选，配置了就发送，不配置则不发送）
ASR_XLS_TOKEN=

# ===== 本地 LLM（OpenAI 兼容 chat/completions）=====
# 使用 host.docker.internal 从容器内访问宿主机服务
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=ollama
LLM_MODEL=qwen3:latest
LLM_TIMEOUT=300

# ===== 存储配置 =====
# 存储根目录，下设 recordings / transcripts / summaries 子目录
# Docker 部署: /data  本地开发: ./data
STORAGE_PATH=./data
DATABASE_URL=sqlite+aiosqlite:///./data/meeting.db

# ===== Zvec 向量数据库 =====
# 向量索引数据存储路径
ZVEC_DATA_PATH=./data/zvec

# ===== CORS 配置 =====
# 逗号分隔的来源列表，* 表示全部允许
CORS_ORIGINS=*

# ===== Webhook 回调（可选）=====
# 转录完成后通知此 URL
WEBHOOK_URL=

# ===== 分享链接密钥 =====
SHARE_SECRET=meeting-transcriber-share-secret-2024

# ===== 登录认证 =====
# 登录密码，局域网部署时建议修改
AUTH_PASSWORD=password
# JWT 密钥
JWT_SECRET=meeting-transcriber-jwt-secret-2024
# Token 有效期（小时）
JWT_EXPIRE_HOURS=72
